{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "micode-local": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server/index.js"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "MICODE_WORKSPACES": "${HOME}/Projects",
        "MICODE_DEFAULT_WORKSPACE": "",
        "MICODE_SSH_CONFIG": "${HOME}/.ssh/config"
      }
    }
  }
}
