# MongoDB Connection (shared with main backend)
MONGODB_URI=mongodb+srv://your-connection-string

# Admin Frontend URL
ADMIN_FRONTEND_URL=http://localhost:8081

# Admin Backend Port
ADMIN_BACKEND_PORT=5001

# Super Admin Initial Access Key (for initial setup/recovery)
SUPER_ADMIN_KEY=your_super_admin_key_here

# Default Super Admin Credentials (will be hashed and stored in DB on first run)
SUPER_ADMIN_EMAIL=admin@devforge.io
SUPER_ADMIN_PASSWORD=your_secure_password_here

# After the server runs and seeds the super admin, copy its _id from the console here.
SUPER_ADMIN_ID=will_be_generated_on_first_run

# JWT Secret for Admin Panel Authentication
JWT_SECRET=your_jwt_secret_here_use_random_string
