PORT=8787
# Generate with: openssl rand -hex 32
MICODE_SERVER_TOKEN=replace-with-a-long-random-secret
# OpenAI-compatible API configuration. Keep provider secrets on the server.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1
# Public HTTPS origin used to generate live preview URLs (e.g. https://agent.example.com)
MICODE_PUBLIC_URL=
# Docker image used for isolated project commands
MICODE_RUNNER_IMAGE=node:22-bookworm-slim
MICODE_WORKSPACES=/var/lib/micode/workspaces
